{
  "name": "@leadoo/react-bot",
  "version": "0.11.0",
  "description": "React components for Leadoo bots",
  "type": "module",
  "exports": "./dist/index.js",
  "typings": "dist/index.d.ts",
  "scripts": {
    "build": "npm run clean && npm run build:web",
    "build:web": "webpack --mode production --config webpack.config.cjs",
    "clean": "node ./scripts/clean.js",
    "dev": "npm run clean && webpack --mode development --config webpack.config.cjs --watch",
    "format": "prettier --write '{source,stories,test}/**/*.{ts,tsx,js,jsx}'",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6008",
    "test": "npm run test:specs && npm run test:format",
    "test:format": "prettier --check \"{source,stories,test}/**/*.{ts,tsx,js,jsx}\"",
    "test:specs": "vitest run"
  },
  "files": [
    "dist/**/*",
    "*.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=26.13",
    "npm": ">=11.20"
  },
  "lint-staged": {
    "{source,stories,test}/**/*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeadooMT/react-bot.git"
  },
  "keywords": [
    "leadoo",
    "react",
    "bot",
    "chat"
  ],
  "author": "Perry Mitchell <perry@leadoo.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/LeadooMT/react-bot/issues"
  },
  "homepage": "https://github.com/LeadooMT/react-bot#readme",
  "devDependencies": {
    "@babel/core": "~8.1.0",
    "@babel/preset-env": "~8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@storybook/react": "^10.5.3",
    "@storybook/react-vite": "~10.6.5",
    "@testing-library/jest-dom": "~7.0.0",
    "@testing-library/react": "~16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-loader": "^10.0.0",
    "husky": "^9.1.7",
    "jsdom": "~30.1.3",
    "lint-staged": "~17.6.0",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "resolve-typescript-plugin": "^2.0.1",
    "storybook": "^10.5.3",
    "ts-loader": "^9.5.4",
    "typescript": "~6.0.3",
    "vite": "~8.3.5",
    "vitest": "~5.0.5",
    "webpack": "^5.109.0",
    "webpack-cli": "~7.3.1"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "overrides": {
    "glob": "^14.0.3"
  }
}
