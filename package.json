{
  "name": "@leadoo/react-bot",
  "version": "0.9.4",
  "description": "React components for Leadoo bots",
  "type": "module",
  "exports": "./dist/index.js",
  "typings": "dist/index.d.ts",
  "scripts": {
    "build": "npm run clean && npm run build:web",
    "build:web": "webpack --mode production --config webpack.config.cjs",
    "clean": "rimraf ./dist",
    "dev": "npm run clean && webpack --mode development --config webpack.config.js --watch",
    "format": "prettier --write '{source,stories,test}/**/*.{ts,tsx,js,jsx}'",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6008",
    "test": "npm run test:specs && npm run test:format",
    "test:format": "prettier-check '{source,stories,test}/**/*.{ts,tsx,js,jsx}'",
    "test:specs": "vitest run"
  },
  "files": [
    "dist/**/*",
    "*.md"
  ],
  "sideEffects": false,
  "lint-staged": {
    "{source,stories,test}/**/*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeadooMT/react-bot.git"
  },
  "keywords": [
    "leadoo",
    "react",
    "bot",
    "chat"
  ],
  "author": "Perry Mitchell <perry@leadoo.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/LeadooMT/react-bot/issues"
  },
  "homepage": "https://github.com/LeadooMT/react-bot#readme",
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@storybook/react": "^10.2.0",
    "@storybook/react-webpack5": "^10.2.0",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "~16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "babel-loader": "^10.0.0",
    "husky": "^4.3.8",
    "jsdom": "~29.1.1",
    "lint-staged": "^15.1.0",
    "prettier": "^3.1.0",
    "prettier-check": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resolve-typescript-plugin": "^2.0.1",
    "rimraf": "^5.0.5",
    "storybook": "^10.2.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "vitest": "~4.1.9",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "overrides": {
    "cross-spawn": "^7.0.6",
    "js-yaml": "4.2.0"
  }
}
